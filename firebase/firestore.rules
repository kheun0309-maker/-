rules_version = '2';
// guideSections 허용: hero|food|alternatives|flights|resort|hopping|massage|tips
// 로컬 게시: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validCode(code) {
      return code is string && code.matches('^[A-Z2-9]{6}$');
    }

    function validNick(n) {
      return n is string && n.size() > 0 && n.size() <= 24;
    }

    function validItemText(t) {
      return t is string && t.size() > 0 && t.size() <= 200;
    }

    function validNoteText(t) {
      return t is string && t.size() > 0 && t.size() <= 500;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && validCode(tripId);

      allow create: if signedIn()
        && validCode(tripId)
        && request.resource.data.code == tripId
        && validNick(request.resource.data.createdByNickname)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.keys().hasAll(['code', 'title', 'createdAt', 'createdByNickname']);

      allow update, delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && validCode(tripId);
        allow create, update: if signedIn()
          && validCode(tripId)
          && uid == request.auth.uid
          && validNick(request.resource.data.nickname)
          && request.resource.data.keys().hasAll(['nickname', 'joinedAt']);

        // 본인 삭제 / 같은 닉네임 정리(재설치) / 어드민(은섹젤)
        allow delete: if signedIn()
          && validCode(tripId)
          && (
            uid == request.auth.uid
            || (
              exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.nickname == '은섹젤'
            )
            || (
              exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.nickname
                == resource.data.nickname
            )
          );
      }

      match /packItems/{itemId} {
        allow read: if signedIn() && validCode(tripId);
        allow create, update: if signedIn()
          && validCode(tripId)
          && validItemText(request.resource.data.text)
          && request.resource.data.done is bool
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy.size() <= 24
          && (
            !('doneBy' in request.resource.data)
            || request.resource.data.doneBy == null
            || (request.resource.data.doneBy is string && request.resource.data.doneBy.size() <= 24)
          )
          && (
            !('updatedBy' in request.resource.data)
            || request.resource.data.updatedBy == null
            || (request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 24)
          );
        allow delete: if signedIn() && validCode(tripId);
      }

      match /taskItems/{itemId} {
        allow read: if signedIn() && validCode(tripId);
        allow create, update: if signedIn()
          && validCode(tripId)
          && validItemText(request.resource.data.text)
          && request.resource.data.done is bool
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy.size() <= 24
          && (
            !('doneBy' in request.resource.data)
            || request.resource.data.doneBy == null
            || (request.resource.data.doneBy is string && request.resource.data.doneBy.size() <= 24)
          )
          && (
            !('updatedBy' in request.resource.data)
            || request.resource.data.updatedBy == null
            || (request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 24)
          );
        allow delete: if signedIn() && validCode(tripId);
      }

      match /notes/{noteId} {
        allow read: if signedIn() && validCode(tripId);
        allow create: if signedIn()
          && validCode(tripId)
          && validNoteText(request.resource.data.text)
          && validNick(request.resource.data.author)
          && request.resource.data.keys().hasAll(['text', 'author', 'createdAt']);
        allow update: if false;
        allow delete: if signedIn() && validCode(tripId);
      }

      match /dayMeta/{dayId} {
        allow read: if signedIn() && validCode(tripId);
        allow create, update: if signedIn()
          && validCode(tripId)
          && dayId.matches('^day[1-4]$')
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80;
        allow delete: if signedIn() && validCode(tripId);
      }

      match /items/{itemId} {
        allow read: if signedIn() && validCode(tripId);
        allow create, update: if signedIn()
          && validCode(tripId)
          && request.resource.data.day is string
          && request.resource.data.day.matches('^day[1-4]$')
          && request.resource.data.order is int
          && request.resource.data.time is string
          && request.resource.data.time.size() <= 40
          && request.resource.data.place is string
          && request.resource.data.place.size() <= 120
          && request.resource.data.task is string
          && request.resource.data.task.size() <= 160
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 800;
        allow delete: if signedIn() && validCode(tripId);
      }

      // 히어로·맛집·대안·항공·숙소·호핑·마사지·주의사항 (이미지 URL 포함, Storage 없음)
      match /guideSections/{sectionId} {
        allow read: if signedIn() && validCode(tripId);
        allow create, update: if signedIn()
          && validCode(tripId)
          && sectionId in ['hero', 'food', 'alternatives', 'flights', 'resort', 'hopping', 'massage', 'tips']
          && validNick(request.resource.data.updatedBy)
          && (
            (sectionId == 'hero'
              && request.resource.data.slides is list
              && request.resource.data.slides.size() > 0
              && request.resource.data.slides.size() <= 8)
            || (sectionId == 'food'
              && request.resource.data.items is list
              && request.resource.data.items.size() <= 20)
            || (sectionId == 'alternatives'
              && request.resource.data.items is list
              && request.resource.data.items.size() <= 16)
            || (sectionId == 'flights'
              && request.resource.data.items is list
              && request.resource.data.items.size() > 0
              && request.resource.data.items.size() <= 8)
            || (sectionId in ['resort', 'hopping', 'massage', 'tips']
              && request.resource.data.items is list
              && request.resource.data.items.size() <= 20)
          );
        allow delete: if signedIn() && validCode(tripId);
      }

      // AI/멤버가 추가한 커스텀 가이드 섹션
      match /customSections/{sectionId} {
        allow read: if signedIn() && validCode(tripId);
        allow create, update: if signedIn()
          && validCode(tripId)
          && sectionId is string
          && sectionId.size() > 0
          && sectionId.size() <= 40
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 60
          && request.resource.data.intro is string
          && request.resource.data.intro.size() <= 300
          && request.resource.data.order is int
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 20
          && validNick(request.resource.data.updatedBy);
        allow delete: if signedIn() && validCode(tripId);
      }

      // 일정 변경 알림용 이벤트 (인앱 배지)
      match /itinEvents/{eventId} {
        allow read: if signedIn() && validCode(tripId);
        allow create: if signedIn()
          && validCode(tripId)
          && request.resource.data.kind is string
          && request.resource.data.kind.size() > 0
          && request.resource.data.kind.size() <= 24
          && request.resource.data.day is string
          && request.resource.data.day.size() <= 12
          && request.resource.data.summary is string
          && request.resource.data.summary.size() > 0
          && request.resource.data.summary.size() <= 200
          && request.resource.data.detail is string
          && request.resource.data.detail.size() <= 400
          && request.resource.data.itemId is string
          && request.resource.data.itemId.size() <= 80
          && validNick(request.resource.data.updatedBy)
          && request.resource.data.keys().hasAll(['kind', 'day', 'summary', 'detail', 'itemId', 'updatedBy', 'updatedAt']);
        allow update: if false;
        allow delete: if signedIn() && validCode(tripId);
      }
    }
  }
}
